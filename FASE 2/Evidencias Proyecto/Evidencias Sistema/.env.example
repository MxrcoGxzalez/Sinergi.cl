# Copia este archivo como .env antes de "docker compose up --build"
DEBUG=True
# Clave de desarrollo; en producción genera una nueva y secreta
SECRET_KEY=dev-cambiar-en-produccion
POSTGRES_DB=sinergi
POSTGRES_USER=sinergi
POSTGRES_PASSWORD=sinergi
DATABASE_URL=postgres://sinergi:sinergi@db:5432/sinergi
# --- Producción / seguridad ---
# Dominios permitidos y orígenes de confianza para CSRF (separados por coma)
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Ruta secreta de Django Admin (solo superusuario), ej: gestion-interna-7f3a/
ADMIN_URL=admin/
# Redis para compartir los límites de intentos entre procesos (recomendado en producción)
REDIS_URL=redis://redis:6379/1
# Producción con HTTPS (docker-compose.prod.yml): true, porque Caddy termina HTTPS delante de Django
BEHIND_PROXY=false
# Dominio público para el certificado HTTPS de Caddy (Let's Encrypt). localhost = certificado local de prueba
DOMINIO=localhost
# Días que un proyecto/solicitud archivado espera antes de eliminarse definitivamente
DIAS_ARCHIVO=60

# Chatbot de clientes (Groq). La clave real va solo en .env, nunca en GitHub.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Respaldos automáticos (servicio "respaldos"): hora diaria y día del semanal (1=lunes ... 7=domingo)
HORA_RESPALDO=03:00
DIA_RESPALDO_SEMANAL=7

# Antivirus ClamAV de los documentos subidos (servicio "clamav"). Si no responde, las subidas se rechazan.
CLAMAV_HOST=clamav
