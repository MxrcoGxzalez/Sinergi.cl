# Copia este archivo como .env antes de "docker compose up --build"
DEBUG=True
# Clave de desarrollo; en producción genera una nueva y secreta
SECRET_KEY=dev-cambiar-en-produccion
POSTGRES_DB=sinergi
POSTGRES_USER=sinergi
POSTGRES_PASSWORD=sinergi
DATABASE_URL=postgres://sinergi:sinergi@db:5432/sinergi
# --- Producción / seguridad ---
# Dominios permitidos y orígenes de confianza para CSRF (separados por coma)
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
# Ruta secreta de Django Admin (solo superusuario), ej: gestion-interna-7f3a/
ADMIN_URL=admin/
# Redis para compartir los límites de intentos entre procesos (recomendado en producción)
REDIS_URL=redis://redis:6379/1
# Celery: tareas automáticas (noticias a las 0, 6, 12 y 18 h; purga diaria) con los servicios
# celery-worker y celery-beat. Tareas en segundo plano, nunca en la petición del visitante.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False
# Producción con HTTPS (docker-compose.prod.yml): true, porque Caddy termina HTTPS delante de Django
BEHIND_PROXY=false
# Dominio público para el certificado HTTPS de Caddy (Let's Encrypt). localhost = certificado local de prueba
DOMINIO=localhost
# Días que un proyecto/solicitud archivado espera antes de eliminarse definitivamente
DIAS_ARCHIVO=60
# Días sin actividad tras los que una conversación de Peticiones & Chat se elimina completa
DIAS_CHAT=60
# SuperAdmin de demostración (manage.py crear_superadmin): cambia entre vistas Admin/Empleado/Cliente
SUPERADMIN_USUARIO=superadmin

# Chatbot de clientes (Groq). La clave real va solo en .env, nunca en GitHub.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Respaldos automáticos (servicio "respaldos"): hora diaria y día del semanal (1=lunes ... 7=domingo)
HORA_RESPALDO=03:00
DIA_RESPALDO_SEMANAL=7

# Antivirus ClamAV de los documentos subidos (servicio "clamav"). Si no responde, las subidas se rechazan.
CLAMAV_HOST=clamav

# Correo saliente (verificación de correo en "Mi perfil"). Sin EMAIL_HOST el correo NO sale a internet:
# se imprime en la terminal del servidor (solo desarrollo).
# Gmail:  EMAIL_HOST=smtp.gmail.com, tu correo en EMAIL_HOST_USER y una "contraseña de aplicación" de 16 letras,
#         sin espacios, en EMAIL_HOST_PASSWORD (https://myaccount.google.com/apppasswords; exige verificación en 2 pasos).
# Brevo:  EMAIL_HOST=smtp-relay.brevo.com, usuario y clave SMTP del panel de Brevo; DEFAULT_FROM_EMAIL con un remitente verificado.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Opcional. Por defecto: Sinergi <EMAIL_HOST_USER>
DEFAULT_FROM_EMAIL=

# Avisos automáticos por correo (cuenta creada, petición nueva, avance de la obra). Los envía celery-worker.
# Dirección pública del sitio para los enlaces de los correos. Vacío: http://localhost:8000, o https://DOMINIO
# si DOMINIO no es localhost.
SITIO_URL=
# Minutos en que los cambios de avance de una obra se juntan en un solo correo al cliente
AVISOS_AGRUPAR_MINUTOS=5
